{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "emitDeclarationOnly": false,
    "sourceMap": true,
    "noEmit": false,
    "outDir": "dist",
    "allowImportingTsExtensions": false,
    "types": ["node"],
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "*": ["src/*", "*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
