{
  "compilerOptions": {
    "module": "ES2020",
    "target": "ES2020",
    "sourceMap": true,
    "strict": false,
    "declaration": true,
    "allowImportingTsExtensions": false,
    "emitDeclarationOnly": false,
    "moduleResolution": "node",
    "outDir": "dist",
    "noEmit": false,
    "types": [
      "node"
    ]
  },
  "include": [
    "src",
  ]
}