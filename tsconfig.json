{
  "compilerOptions": {
    "module": "ES2020",
    "target": "ES2020",
    "sourceMap": true,
    "strict": false,
    "declaration": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "node",
    "outDir": "dist",
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "exclude": [
    "dist",
    "node_modules",
    "make-release.ts"
  ]
}